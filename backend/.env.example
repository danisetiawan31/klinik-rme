# Copy file ini menjadi .env di lingkungan lokal kamu:
# Copy-Item .env.example .env

# --- Database (PostgreSQL) ---
# Variabel wajib - server akan gagal start jika salah satu kosong (lihat internal/config/config.go)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password_postgres_lokal_kamu
DB_NAME=klinik_rme

# --- Timezone ---
# Wajib - di-set global ke seluruh proses (Asia/Jakarta)
TZ=Asia/Jakarta

# --- HTTP Server ---
# Opsional - default 8080 jika tidak diisi
PORT=8080

# --- Email (Resend) & Frontend Base URL & Seed Admin ---
# Wajib
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:4200
SEED_ADMIN_EMAIL=admin@klinik.local
